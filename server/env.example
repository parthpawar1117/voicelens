# Copy this file to server/.env and fill in real values. Never commit server/.env.
#   cp server/env.example server/.env

# From https://my.telegram.org -> API development tools
TELEGRAM_API_ID=123456
TELEGRAM_API_HASH=replace_with_your_api_hash

# Local file name for the Telethon session (stored in server/, gitignored)
TELEGRAM_SESSION_NAME=voicelens

# Port for the local FastAPI server
SERVER_PORT=8787

# Optional, for demo videos: a bot that plays "the friend" (create with @BotFather,
# then press Start in its chat). Its chat is watched automatically.
TELEGRAM_DEMO_BOT_TOKEN=
